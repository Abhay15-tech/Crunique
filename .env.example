# CRUNIQUE Enterprise Environment Variables Schema

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:8080
NODE_ENV=development

# Database (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crunique_db?schema=public"

# Authentication (Auth.js / NextAuth)
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=crunique_enterprise_nextauth_secret_key_32bytes_min

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Payment Gateway (Razorpay - Test or Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Image Storage (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=crunique
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Resend)
RESEND_API_KEY=re_1234567890_your_resend_api_key
EMAIL_FROM="CRUNIQUE Family Concierge <hello@crunique.com>"
